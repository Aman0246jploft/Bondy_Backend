# Database
DB_STRING=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/Bondy?retryWrites=true&w=majority

# Server
PORT=8080
API_END_POINT_V1=/api/v1/
SALT_WORK_FACTOR=10
NODE_ENV=development

# JWT Secrets
JWT_SECRET_KEY=your_jwt_secret_key
REFRESH_JWT_SECRET_KEY=your_refresh_jwt_secret_key
JWT_EXPIRE=10000d
REFRESH_JWT_EXPIRE=7d
OTP_EXPIRY_MINUTES=10

# URLs
BACKEND_URL=https://dev.tasksplan.com/bondyBackend
BASE_URL=https://dev.tasksplan.com/bondyBackend
FRONTEND_URL=https://bondy-user.tasksplan.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Commission
COMMISSION_CONFIG=COMMISSION_CONFIG

# OAuth
GOOGLE_CLIENT_ID=your_google_client_id
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
APPLE_CLIENT_ID=com.your.bundle.id

# ════════════════════════════════════════════════════════════════════════════
# QPAY PAYMENT GATEWAY CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════
# Mode: 'sandbox' or 'production'
QPAY_ENV=sandbox

# Base URL (Optional, defaults automatically based on QPAY_ENV):
# Sandbox:    https://merchant-sandbox.qpay.mn/v2
# Production: https://merchant.qpay.mn/v2
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn/v2

# Merchant Credentials (Issued by QPay merchant onboarding):
# Sandbox default:    TEST_MERCHANT / 123456 / TEST_INVOICE
# Production default: Your live Merchant username, password, invoice code
QPAY_USERNAME=TEST_MERCHANT
QPAY_PASSWORD=123456
QPAY_INVOICE_CODE=TEST_INVOICE

# Public Webhook Callback (The HTTPS URL where QPay sends payment confirmation GET requests):
QPAY_CALLBACK_URL=https://your-domain.com/api/v1/booking/qpay/callback

# Secret Token to authenticate webhook callbacks:
QPAY_CALLBACK_SECRET=your_qpay_callback_secret_token

# Optional HTTP Request Timeout in milliseconds (default: 10000):
QPAY_TIMEOUT_MS=10000
